{
  "api_version": "trainvm.rwkv-lab/v1alpha1",
  "kind": "Experiment",
  "metadata": {
    "name": "mageflow-cache-artifact-continuation",
    "description": "Train to a fixed baseline boundary, derive a zero-gated TREAD controller and exact cache coverage, continue with both immutable handoffs, then evaluate the final immutable checkpoint.",
    "labels": {
      "family": "mageflow",
      "handoff": "checkpoint-cache-tread-eval"
    }
  },
  "spec": {
    "workspace": {
      "root": "/thearray/git/moe-mla",
      "run_directory": "/thearray/git/moe-mla/runs/mageflow-cache-artifact-continuation",
      "concurrency_key": "local-gpu-training",
      "allowed_read_roots": [
        "/thearray/git/moe-mla",
        "/thearray/git/datasets",
        "/thearray/git/ob/text-generation-webui/models"
      ],
      "allowed_write_roots": [
        "/thearray/git/moe-mla/runs/mageflow-cache-artifact-continuation"
      ]
    },
    "resources": {
      "accelerators": {
        "vendor": "nvidia",
        "count": 1,
        "minimum_memory_gib": 48,
        "exclusive": true
      },
      "minimum_host_memory_gib": 64,
      "cpu_threads": 16,
      "lease_timeout_seconds": 30,
      "cpu_io_policy": {
        "cpuset": "0-15",
        "cpu_weight": 100,
        "io_weight": 100,
        "omp_threads": 8,
        "preprocessing_workers": 8,
        "nice": 0
      }
    },
    "parameters": {},
    "artifacts": {
      "boundary_checkpoint": {
        "type": "checkpoint",
        "schema": "rwkv-lab.mageflow-checkpoint.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "final_checkpoint": {
        "type": "checkpoint",
        "schema": "rwkv-lab.mageflow-checkpoint.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "cache_plan": {
        "type": "report",
        "schema": "rwkv-lab.mageflow-cache-plan.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "encoder_cache": {
        "type": "dataset",
        "schema": "rwkv-lab.encoder-cache.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "tread_controller": {
        "type": "opaque",
        "schema": "rwkv-lab.mageflow-tread-controller.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "standalone_eval_gallery": {
        "type": "image_gallery",
        "schema": "rwkv-lab.eval-gallery.v2",
        "immutability": "append_only",
        "fingerprint": "manifest_sha256"
      },
      "standalone_eval_result": {
        "type": "report",
        "schema": "rwkv-lab.mageflow-eval-result.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      }
    },
    "components": {
      "core": {
        "adapter": "trainvm.core",
        "version": "1.0.0",
        "runtime": "builtin",
        "operations": {
          "acquire_resources": {
            "contract": "trainvm.v1.AcquireResources"
          },
          "release_resources": {
            "contract": "trainvm.v1.ReleaseResources"
          }
        }
      },
      "mageflow": {
        "adapter": "rwkv-lab.mageflow-terminal-expert",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "train": {
            "contract": "rwkv_lab.mageflow_terminal_expert.v1.Train"
          }
        }
      },
      "cache_plan": {
        "adapter": "rwkv-lab.mageflow-cache-plan",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "prepare": {
            "contract": "rwkv_lab.mageflow_cache_plan.v1.Prepare"
          }
        }
      },
      "cache_build": {
        "adapter": "rwkv-lab.mageflow-cache-build",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "build": {
            "contract": "rwkv_lab.mageflow_cache_build.v1.Build"
          }
        }
      },
      "tread_convert": {
        "adapter": "rwkv-lab.mageflow-tread-convert",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "convert": {
            "contract": "rwkv_lab.mageflow_tread_convert.v1.Convert"
          }
        }
      },
      "mageflow_eval": {
        "adapter": "rwkv-lab.mageflow-eval",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "evaluate": {
            "contract": "rwkv_lab.mageflow_eval.v1.Evaluate"
          }
        }
      }
    },
    "workflow": {
      "entrypoint": "acquire_gpu",
      "nodes": {
        "acquire_gpu": {
          "invoke": {
            "component": "core",
            "operation": "acquire_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "local-gpu-training"
              }
            }
          },
          "idempotency": "receipt_required",
          "effect": "resource",
          "transitions": [
            {
              "on": "resource.acquired",
              "target": "train_to_boundary"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "train_to_boundary": {
          "description": "Produce a compatible checkpoint at optimizer step 5500.",
          "invoke": {
            "component": "mageflow",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "domain": "animation",
                  "train_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/train.jsonl",
                  "eval_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/eval.jsonl",
                  "expert_checkpoint": "/thearray/git/moe-mla/runs/mage_flow_terminal_tread_loop_repa_fixed_v2/checkpoint-00004500/mageflow-animation-terminal-expert.safetensors",
                  "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                  "output_dir": "/thearray/git/moe-mla/runs/mageflow-cache-artifact-continuation",
                  "max_steps": 5500,
                  "microbatch_size": 4,
                  "gradient_accumulation_steps": 2,
                  "attention_backend": "flash2",
                  "repa_enabled": false,
                  "repa_loss_weight": 0.0,
                  "encoder_cache_mode": "off",
                  "tread_factored_looping": {}
                }
              }
            },
            "training": {
              "model_family": "mageflow",
              "components": {
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "learning_rate": {
                  "key": {
                    "category": "learning_rate_schedule",
                    "name": "linear_warmup_cosine",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "loop_gate_gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "torch_adamw_no_decay",
                    "version": "2.0.0"
                  },
                  "configuration": {}
                },
                "parameter_router": {
                  "key": {
                    "category": "parameter_router",
                    "name": "mageflow_terminal_expert",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "weight_decay": {
                  "key": {
                    "category": "weight_decay_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                }
              }
            }
          },
          "publishes": {
            "checkpoint": "boundary_checkpoint"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "transitions": [
            {
              "on": "worker.completed",
              "target": "convert_tread"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "convert_tread": {
          "description": "Create one immutable zero-gated controller from the exact boundary checkpoint.",
          "invoke": {
            "component": "tread_convert",
            "operation": "convert",
            "inputs": {
              "config": {
                "literal": {
                  "domain": "animation",
                  "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                  "tread_config": "/thearray/git/moe-mla/experiments/mageflow_tread_factored_looping.json",
                  "model_id": "microsoft/Mage-Flow-Base",
                  "model_revision": "59a9cfd58cf6ecef28245852c6bdace3f12428a2",
                  "attention_backend": "flash2"
                }
              },
              "checkpoint": {
                "artifact": "boundary_checkpoint"
              }
            }
          },
          "publishes": {
            "tread_controller": "tread_controller"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "retry": {
            "maximum_attempts": 2,
            "backoff": "fixed",
            "initial_delay_seconds": 5,
            "retryable_events": [
              "worker.lost",
              "worker.out_of_memory"
            ]
          },
          "transitions": [
            {
              "on": "operation.completed",
              "target": "prepare_cache"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "prepare_cache": {
          "invoke": {
            "component": "cache_plan",
            "operation": "prepare",
            "inputs": {
              "config": {
                "literal": {
                  "optimizer_steps": 6728,
                  "trainer": {
                    "domain": "animation",
                    "train_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/train.jsonl",
                    "eval_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/eval.jsonl",
                    "expert_checkpoint": "/thearray/git/moe-mla/runs/mage_flow_terminal_tread_loop_repa_fixed_v2/checkpoint-00004500/mageflow-animation-terminal-expert.safetensors",
                    "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                    "output_dir": "/thearray/git/moe-mla/runs/mageflow-cache-artifact-continuation",
                    "max_steps": 12228,
                    "microbatch_size": 4,
                    "gradient_accumulation_steps": 2,
                    "attention_backend": "flash2",
                    "repa_enabled": false,
                    "repa_loss_weight": 0.0,
                    "encoder_cache_mode": "off",
                    "tread_factored_looping": {}
                  }
                }
              },
              "checkpoint": {
                "artifact": "boundary_checkpoint"
              }
            }
          },
          "publishes": {
            "plan": "cache_plan"
          },
          "idempotency": "replay_safe",
          "effect": "workspace_write",
          "transitions": [
            {
              "on": "operation.completed",
              "target": "build_cache"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "build_cache": {
          "invoke": {
            "component": "cache_build",
            "operation": "build",
            "inputs": {
              "plan": {
                "artifact": "cache_plan"
              },
              "checkpoint": {
                "artifact": "boundary_checkpoint"
              }
            }
          },
          "publishes": {
            "cache": "encoder_cache"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "retry": {
            "maximum_attempts": 3,
            "backoff": "exponential",
            "initial_delay_seconds": 5,
            "maximum_delay_seconds": 60,
            "retryable_events": [
              "worker.lost",
              "worker.out_of_memory"
            ]
          },
          "transitions": [
            {
              "on": "operation.completed",
              "target": "resume_training"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "resume_training": {
          "description": "Continue from the checkpoint with its lineage-bound immutable cache and zero-gated TREAD controller.",
          "invoke": {
            "component": "mageflow",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "domain": "animation",
                  "train_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/train.jsonl",
                  "eval_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/eval.jsonl",
                  "expert_checkpoint": "/thearray/git/moe-mla/runs/mage_flow_terminal_tread_loop_repa_fixed_v2/checkpoint-00004500/mageflow-animation-terminal-expert.safetensors",
                  "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                  "output_dir": "/thearray/git/moe-mla/runs/mageflow-cache-artifact-continuation",
                  "max_steps": 12228,
                  "microbatch_size": 4,
                  "gradient_accumulation_steps": 2,
                  "attention_backend": "flash2",
                  "repa_enabled": false,
                  "repa_loss_weight": 0.0,
                  "encoder_cache_mode": "off",
                  "reset_optimizer_on_architecture_migration": true
                }
              },
              "checkpoint": {
                "artifact": "boundary_checkpoint"
              },
              "cache": {
                "artifact": "encoder_cache"
              },
              "tread_controller": {
                "artifact": "tread_controller"
              }
            },
            "training": {
              "model_family": "mageflow",
              "components": {
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "learning_rate": {
                  "key": {
                    "category": "learning_rate_schedule",
                    "name": "linear_warmup_cosine",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "loop_gate_gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "torch_adamw_no_decay",
                    "version": "2.0.0"
                  },
                  "configuration": {}
                },
                "parameter_router": {
                  "key": {
                    "category": "parameter_router",
                    "name": "mageflow_terminal_expert",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "weight_decay": {
                  "key": {
                    "category": "weight_decay_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                }
              }
            }
          },
          "publishes": {
            "checkpoint": "final_checkpoint"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "transitions": [
            {
              "on": "worker.completed",
              "target": "evaluate_final"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "evaluate_final": {
          "description": "Run scalar and generated/original evaluation directly against the immutable final checkpoint without creating training state.",
          "invoke": {
            "component": "mageflow_eval",
            "operation": "evaluate",
            "inputs": {
              "config": {
                "literal": {
                  "domain": "animation",
                  "eval_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/eval.jsonl",
                  "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                  "eval_microbatch_size": 1,
                  "eval_examples": 32,
                  "attention_backend": "flash2"
                }
              },
              "checkpoint": {
                "artifact": "final_checkpoint"
              }
            }
          },
          "publishes": {
            "eval_gallery": "standalone_eval_gallery",
            "result": "standalone_eval_result"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "transitions": [
            {
              "on": "operation.completed",
              "target": "release_gpu"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "release_gpu": {
          "invoke": {
            "component": "core",
            "operation": "release_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "local-gpu-training"
              }
            }
          },
          "idempotency": "replay_safe",
          "effect": "resource",
          "transitions": [
            {
              "on": "resource.released",
              "target": "$completed"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        }
      }
    },
    "controls": {
      "catalog": {}
    },
    "observability": {
      "heartbeat_seconds": 5,
      "metrics": [
        {
          "name": "train.loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "weighted_mean"
        },
        {
          "name": "train.images_per_second",
          "type": "gauge",
          "unit": "image/second",
          "step_domain": "optimizer_step",
          "aggregation": "mean"
        },
        {
          "name": "eval/primary_loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "eval/optimization_loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "eval/gallery_samples",
          "type": "gauge",
          "unit": "image",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        }
      ],
      "retain_raw_metrics_days": 30,
      "eval_gallery_artifact": "standalone_eval_gallery"
    },
    "recovery": {
      "exact_resume": false,
      "checkpoint_artifact": "final_checkpoint",
      "reconcile": "adopt_if_fingerprint_matches",
      "orphan_policy": "adopt_if_identity_matches",
      "graceful_stop_seconds": 300,
      "release_accelerators_when_paused": true
    }
  }
}
