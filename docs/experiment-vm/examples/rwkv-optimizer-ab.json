{
  "api_version": "trainvm.rwkv-lab/v1alpha1",
  "kind": "Experiment",
  "metadata": {
    "name": "rwkv-optimizer-ab",
    "description": "Compare SpectralMuon and AdamW on identical fixed-step pretrained RWKV windows.",
    "labels": {
      "family": "rwkv",
      "campaign": "optimizer-ab"
    }
  },
  "spec": {
    "workspace": {
      "root": "/thearray/git/moe-mla",
      "run_directory": "/thearray/git/moe-mla/runs/trainvm/rwkv-optimizer-ab",
      "concurrency_key": "rwkv-optimizer-ab",
      "allowed_read_roots": [
        "/thearray/git/moe-mla/models"
      ],
      "allowed_write_roots": [
        "/thearray/git/moe-mla/runs/trainvm/rwkv-optimizer-ab"
      ]
    },
    "resources": {
      "accelerators": {
        "vendor": "nvidia",
        "count": 1,
        "minimum_memory_gib": 48,
        "exclusive": true
      },
      "minimum_host_memory_gib": 64,
      "cpu_threads": 8,
      "lease_timeout_seconds": 30,
      "cpu_io_policy": {
        "cpu_weight": 100,
        "io_weight": 100,
        "omp_threads": 4,
        "preprocessing_workers": 2,
        "nice": 0
      }
    },
    "parameters": {},
    "artifacts": {
      "spectral_checkpoint": {
        "type": "checkpoint",
        "schema": "rwkv-lab.rwkv-optimizer-finetune-checkpoint.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "adamw_checkpoint": {
        "type": "checkpoint",
        "schema": "rwkv-lab.rwkv-optimizer-finetune-checkpoint.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "spectral_result": {
        "type": "report",
        "schema": "rwkv-lab.scalar-metric-result.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "adamw_result": {
        "type": "report",
        "schema": "rwkv-lab.scalar-metric-result.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      },
      "optimizer_decision": {
        "type": "report",
        "schema": "rwkv-lab.scalar-metric-decision.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256"
      }
    },
    "components": {
      "core": {
        "adapter": "trainvm.core",
        "version": "1.0.0",
        "runtime": "builtin",
        "operations": {
          "acquire_resources": {
            "contract": "trainvm.v1.AcquireResources"
          },
          "release_resources": {
            "contract": "trainvm.v1.ReleaseResources"
          }
        }
      },
      "rwkv_optimizer": {
        "adapter": "rwkv-lab.rwkv-optimizer-finetune",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "train": {
            "contract": "rwkv_lab.rwkv_optimizer_finetune.v1.Train"
          }
        }
      },
      "decision": {
        "adapter": "rwkv-lab.scalar-metric-decision",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "decide": {
            "contract": "rwkv_lab.scalar_metric_decision.v1.Decide"
          }
        }
      }
    },
    "workflow": {
      "entrypoint": "acquire_gpu",
      "nodes": {
        "acquire_gpu": {
          "invoke": {
            "component": "core",
            "operation": "acquire_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "rwkv-optimizer-ab"
              }
            }
          },
          "idempotency": "receipt_required",
          "effect": "resource",
          "transitions": [
            {
              "on": "resource.acquired",
              "target": "spectral_arm"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "spectral_arm": {
          "invoke": {
            "component": "rwkv_optimizer",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "model_path": "/thearray/git/moe-mla/models/rwkv7-g1g-1.5b.pth",
                  "data_path": "/thearray/git/moe-mla/models/g1g_tokens.bin",
                  "max_steps": 1000,
                  "subject": "spectral_muon",
                  "sequence_length": 1024,
                  "batch_size": 8,
                  "validation_windows": 32,
                  "eval_every": 50,
                  "log_every": 5,
                  "checkpoint_every": 250,
                  "keep_last_n": 2,
                  "seed": 1729,
                  "dtype": "bf16"
                }
              }
            },
            "training": {
              "model_family": "rwkv",
              "components": {
                "artifact_renderer": {
                  "key": {
                    "category": "artifact_renderer",
                    "name": "evidence_envelope",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "modality": "text",
                    "schema": "trainvm.eval-evidence.v1"
                  }
                },
                "evaluation_schedule": {
                  "key": {
                    "category": "evaluation_schedule",
                    "name": "milestone_cadence",
                    "version": "3.0.0"
                  },
                  "configuration": {
                    "full_step_zero": true,
                    "final": true,
                    "full_every_steps": 50
                  }
                },
                "evaluator": {
                  "key": {
                    "category": "evaluator",
                    "name": "scalar_loss",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "split_slot": "",
                    "metrics": [
                      "eval.loss"
                    ],
                    "reduction": "weighted_mean",
                    "maximum_examples": 0
                  }
                },
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "max_norm": 1.0
                  }
                },
                "learning_rate": {
                  "key": {
                    "category": "learning_rate_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "spectral_muon_no_decay",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "learning_rate": 0.0001
                  }
                },
                "parameter_router": {
                  "key": {
                    "category": "parameter_router",
                    "name": "rwkv_matrix_optimizer",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "fallback_multiplier": 0.1
                  }
                },
                "qualitative_samples": {
                  "key": {
                    "category": "qualitative_sample",
                    "name": "fixed_held_out",
                    "version": "2.0.0"
                  },
                  "configuration": {
                    "identity_field": "window",
                    "sample_count": 8
                  }
                },
                "weight_decay": {
                  "key": {
                    "category": "weight_decay_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "weight_decay": 0.0
                  }
                }
              }
            }
          },
          "publishes": {
            "checkpoint": "spectral_checkpoint",
            "result": "spectral_result"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "timeout_seconds": 172800,
          "transitions": [
            {
              "on": "worker.completed",
              "target": "adamw_arm"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "adamw_arm": {
          "invoke": {
            "component": "rwkv_optimizer",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "model_path": "/thearray/git/moe-mla/models/rwkv7-g1g-1.5b.pth",
                  "data_path": "/thearray/git/moe-mla/models/g1g_tokens.bin",
                  "max_steps": 1000,
                  "subject": "adamw",
                  "sequence_length": 1024,
                  "batch_size": 8,
                  "validation_windows": 32,
                  "eval_every": 50,
                  "log_every": 5,
                  "checkpoint_every": 250,
                  "keep_last_n": 2,
                  "seed": 1729,
                  "dtype": "bf16"
                }
              }
            },
            "training": {
              "model_family": "rwkv",
              "components": {
                "artifact_renderer": {
                  "key": {
                    "category": "artifact_renderer",
                    "name": "evidence_envelope",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "modality": "text",
                    "schema": "trainvm.eval-evidence.v1"
                  }
                },
                "evaluation_schedule": {
                  "key": {
                    "category": "evaluation_schedule",
                    "name": "milestone_cadence",
                    "version": "3.0.0"
                  },
                  "configuration": {
                    "full_step_zero": true,
                    "final": true,
                    "full_every_steps": 50
                  }
                },
                "evaluator": {
                  "key": {
                    "category": "evaluator",
                    "name": "scalar_loss",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "split_slot": "",
                    "metrics": [
                      "eval.loss"
                    ],
                    "reduction": "weighted_mean",
                    "maximum_examples": 0
                  }
                },
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "max_norm": 1.0
                  }
                },
                "learning_rate": {
                  "key": {
                    "category": "learning_rate_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {}
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "torch_adamw_no_decay",
                    "version": "2.0.0"
                  },
                  "configuration": {
                    "learning_rate": 0.0001,
                    "beta1": 0.9,
                    "beta2": 0.95,
                    "epsilon": 1e-08,
                    "foreach": true,
                    "fused": false
                  }
                },
                "parameter_router": {
                  "key": {
                    "category": "parameter_router",
                    "name": "rwkv_matrix_optimizer",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "fallback_multiplier": 0.1
                  }
                },
                "qualitative_samples": {
                  "key": {
                    "category": "qualitative_sample",
                    "name": "fixed_held_out",
                    "version": "2.0.0"
                  },
                  "configuration": {
                    "identity_field": "window",
                    "sample_count": 8
                  }
                },
                "weight_decay": {
                  "key": {
                    "category": "weight_decay_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "weight_decay": 0.0
                  }
                }
              }
            }
          },
          "publishes": {
            "checkpoint": "adamw_checkpoint",
            "result": "adamw_result"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "timeout_seconds": 172800,
          "transitions": [
            {
              "on": "worker.completed",
              "target": "compare_arms"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "compare_arms": {
          "invoke": {
            "component": "decision",
            "operation": "decide",
            "inputs": {
              "config": {
                "literal": {
                  "metric": "eval.loss",
                  "direction": "minimize",
                  "left_subject": "spectral_muon",
                  "right_subject": "adamw",
                  "absolute_tolerance": 0.0
                }
              },
              "left": {
                "artifact": "spectral_result"
              },
              "right": {
                "artifact": "adamw_result"
              }
            }
          },
          "publishes": {
            "decision": "optimizer_decision"
          },
          "idempotency": "receipt_required",
          "effect": "process",
          "transitions": [
            {
              "on": "operation.completed",
              "target": "release_gpu"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "release_gpu": {
          "invoke": {
            "component": "core",
            "operation": "release_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "rwkv-optimizer-ab"
              }
            }
          },
          "idempotency": "replay_safe",
          "effect": "resource",
          "transitions": [
            {
              "on": "resource.released",
              "target": "$completed"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        }
      }
    },
    "controls": {
      "catalog": {}
    },
    "observability": {
      "heartbeat_seconds": 5,
      "metrics": [
        {
          "name": "train.loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "mean"
        },
        {
          "name": "train.gradient_norm",
          "type": "gauge",
          "unit": "ratio",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "train.learning_rate",
          "type": "gauge",
          "unit": "ratio",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "train.tokens_per_second",
          "type": "gauge",
          "unit": "token/second",
          "step_domain": "optimizer_step",
          "aggregation": "mean"
        },
        {
          "name": "train.step_seconds",
          "type": "gauge",
          "unit": "second",
          "step_domain": "optimizer_step",
          "aggregation": "mean"
        },
        {
          "name": "eval.loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "eval.perplexity",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "system.gpu_memory_used",
          "type": "gauge",
          "unit": "byte",
          "step_domain": "optimizer_step",
          "aggregation": "max"
        }
      ],
      "retain_raw_metrics_days": 30
    },
    "recovery": {
      "exact_resume": false,
      "reconcile": "adopt_if_fingerprint_matches",
      "orphan_policy": "adopt_if_identity_matches",
      "graceful_stop_seconds": 300,
      "release_accelerators_when_paused": true
    }
  }
}
