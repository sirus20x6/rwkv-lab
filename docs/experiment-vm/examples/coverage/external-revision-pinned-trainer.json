{
  "api_version": "trainvm.rwkv-lab/v1alpha1",
  "kind": "Experiment",
  "metadata": {
    "name": "coverage-external-revision-pinned-trainer",
    "description": "Compiler coverage for revision verification, preprocessing, compatible upstream training, and validation.",
    "labels": {"family": "external-trainer", "fixture": "compiler-coverage"}
  },
  "spec": {
    "workspace": {
      "root": "/thearray/git/moe-mla",
      "run_directory": "/thearray/git/moe-mla/runs/trainvm-coverage/external-revision-pinned-trainer",
      "concurrency_key": "coverage-external-pinned",
      "allowed_read_roots": ["/thearray/git/moe-mla"],
      "allowed_write_roots": ["/thearray/git/moe-mla/runs/trainvm-coverage/external-revision-pinned-trainer"]
    },
    "resources": {
      "accelerators": {"vendor": "nvidia", "count": 1, "minimum_memory_gib": 48, "exclusive": true},
      "minimum_host_memory_gib": 64,
      "cpu_threads": 12,
      "lease_timeout_seconds": 30,
      "cpu_io_policy": {"cpu_weight": 100, "io_weight": 100, "omp_threads": 8, "preprocessing_workers": 4, "nice": 0}
    },
    "parameters": {
      "upstream_repository": {"type": "string", "value": "https://example.invalid/upstream/trainer"},
      "upstream_revision": {"type": "string", "value": "0123456789abcdef0123456789abcdef01234567"},
      "source_manifest_path": {"type": "path", "value": "/thearray/git/moe-mla/fixtures/external/source-manifest.jsonl"},
      "optimizer_steps": {"type": "integer", "value": 400}
    },
    "artifacts": {
      "revision_receipt": {"type": "report", "schema": "coverage.external-revision.v1", "immutability": "immutable", "fingerprint": "sha256"},
      "preprocessed_dataset": {"type": "dataset", "schema": "coverage.external-preprocessed.v1", "immutability": "immutable", "fingerprint": "manifest_sha256"},
      "upstream_checkpoint": {"type": "checkpoint", "schema": "coverage.external-compatible-checkpoint.v1", "immutability": "immutable", "fingerprint": "manifest_sha256"},
      "validation_report": {"type": "report", "schema": "coverage.external-validation.v1", "immutability": "immutable", "fingerprint": "sha256"}
    },
    "components": {
      "core": {
        "adapter": "trainvm.core",
        "version": "1.0.0",
        "runtime": "builtin",
        "operations": {
          "acquire_resources": {"contract": "trainvm.v1.AcquireResources"},
          "release_resources": {"contract": "trainvm.v1.ReleaseResources"}
        }
      },
      "external_trainer": {
        "adapter": "coverage.external-pinned-trainer",
        "version": "1.0.0-coverage",
        "runtime": "external_worker",
        "operations": {
          "verify_revision": {"contract": "coverage.external_pinned.v1.VerifyCleanRevision"},
          "preprocess": {"contract": "coverage.external_pinned.v1.PreprocessPinnedInputs"},
          "train": {"contract": "coverage.external_pinned.v1.TrainCompatibleUpstream"},
          "validate": {"contract": "coverage.external_pinned.v1.ValidateCheckpoint"}
        }
      }
    },
    "workflow": {
      "entrypoint": "acquire_resources",
      "nodes": {
        "acquire_resources": {
          "invoke": {"component": "core", "operation": "acquire_resources", "inputs": {
            "concurrency_key": {"literal": "coverage-external-pinned"}
          }},
          "idempotency": "receipt_required",
          "effect": "resource",
          "transitions": [
            {"on": "resource.acquired", "target": "verify_revision"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "verify_revision": {
          "invoke": {"component": "external_trainer", "operation": "verify_revision", "inputs": {
            "repository": {"parameter": "upstream_repository"},
            "revision": {"parameter": "upstream_revision"}
          }},
          "publishes": {"receipt": "revision_receipt"},
          "idempotency": "replay_safe",
          "effect": "external",
          "timeout_seconds": 600,
          "transitions": [
            {"on": "artifact.validated", "target": "preprocess"},
            {"on": "artifact.invalid", "target": "$failed"}
          ]
        },
        "preprocess": {
          "invoke": {"component": "external_trainer", "operation": "preprocess", "inputs": {
            "revision": {"artifact": "revision_receipt"},
            "source_manifest": {"parameter": "source_manifest_path"},
            "run_directory": {"context": "run_directory"}
          }},
          "publishes": {"dataset": "preprocessed_dataset"},
          "idempotency": "receipt_required",
          "effect": "external",
          "timeout_seconds": 14400,
          "transitions": [
            {"on": "operation.completed", "target": "train"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "train": {
          "invoke": {"component": "external_trainer", "operation": "train", "inputs": {
            "revision": {"artifact": "revision_receipt"},
            "dataset": {"artifact": "preprocessed_dataset"},
            "steps": {"parameter": "optimizer_steps"},
            "run_directory": {"context": "run_directory"}
          }},
          "publishes": {"checkpoint": "upstream_checkpoint"},
          "idempotency": "receipt_required",
          "effect": "process",
          "timeout_seconds": 86400,
          "transitions": [
            {"on": "worker.completed", "target": "validate"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "validate": {
          "invoke": {"component": "external_trainer", "operation": "validate", "inputs": {
            "revision": {"artifact": "revision_receipt"},
            "dataset": {"artifact": "preprocessed_dataset"},
            "checkpoint": {"artifact": "upstream_checkpoint"}
          }},
          "publishes": {"report": "validation_report"},
          "idempotency": "replay_safe",
          "effect": "process",
          "timeout_seconds": 7200,
          "transitions": [
            {"on": "operation.completed", "target": "release_resources"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "release_resources": {
          "invoke": {"component": "core", "operation": "release_resources", "inputs": {
            "concurrency_key": {"literal": "coverage-external-pinned"}
          }},
          "idempotency": "replay_safe",
          "effect": "resource",
          "transitions": [
            {"on": "resource.released", "target": "$completed"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        }
      }
    },
    "controls": {"catalog": {
      "validation_every": {
        "type": "integer", "default": 100, "minimum": 1, "maximum": 10000,
        "apply": "restart", "mutable_after_start": false,
        "targets": ["external_trainer.train.validation_every"], "unit": "optimizer_step"
      }
    }},
    "observability": {
      "heartbeat_seconds": 10,
      "metrics": [
        {"name": "train.loss", "type": "gauge", "unit": "dimensionless", "step_domain": "optimizer_step", "aggregation": "weighted_mean"},
        {"name": "eval.validation_loss", "type": "gauge", "unit": "dimensionless", "step_domain": "optimizer_step", "aggregation": "min"}
      ],
      "retain_raw_metrics_days": 30
    },
    "recovery": {
      "exact_resume": false,
      "checkpoint_artifact": "upstream_checkpoint",
      "reconcile": "restart_from_checkpoint",
      "orphan_policy": "leave_and_block",
      "graceful_stop_seconds": 300
    }
  }
}
