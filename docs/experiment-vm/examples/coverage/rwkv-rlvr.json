{
  "api_version": "trainvm.rwkv-lab/v1alpha1",
  "kind": "Experiment",
  "metadata": {
    "name": "coverage-rwkv-rlvr",
    "description": "Compiler coverage for sealed RLVR tasks and verifier identity followed by compatible-grade policy training.",
    "labels": {"family": "rwkv-rlvr", "fixture": "compiler-coverage"}
  },
  "spec": {
    "workspace": {
      "root": "/thearray/git/moe-mla",
      "run_directory": "/thearray/git/moe-mla/runs/trainvm-coverage/rwkv-rlvr",
      "concurrency_key": "coverage-rwkv-rlvr",
      "allowed_read_roots": ["/thearray/git/moe-mla"],
      "allowed_write_roots": ["/thearray/git/moe-mla/runs/trainvm-coverage/rwkv-rlvr"]
    },
    "resources": {
      "accelerators": {"vendor": "nvidia", "count": 1, "minimum_memory_gib": 40, "exclusive": true},
      "minimum_host_memory_gib": 64,
      "cpu_threads": 12,
      "lease_timeout_seconds": 30,
      "cpu_io_policy": {"cpu_weight": 100, "io_weight": 100, "omp_threads": 8, "preprocessing_workers": 4, "nice": 0}
    },
    "parameters": {
      "parent_checkpoint_path": {"type": "path", "value": "/thearray/git/moe-mla/fixtures/checkpoints/rwkv-rlvr-parent.pt"},
      "heldout_tasks_path": {"type": "path", "value": "/thearray/git/moe-mla/fixtures/rlvr/tasks.jsonl"},
      "verifier_identity": {"type": "string", "value": "coverage.math-verifier.v1"},
      "rollout_token_budget": {"type": "integer", "value": 1000000}
    },
    "artifacts": {
      "rlvr_inputs": {"type": "opaque", "schema": "coverage.rlvr-input-contract.v1", "immutability": "immutable", "fingerprint": "manifest_sha256"},
      "policy_checkpoint": {"type": "checkpoint", "schema": "coverage.rlvr-compatible-checkpoint.v1", "immutability": "immutable", "fingerprint": "manifest_sha256"},
      "rollout_metrics": {"type": "metrics", "schema": "coverage.rlvr-metrics.v1", "immutability": "append_only", "fingerprint": "sha256"},
      "evaluation_report": {"type": "report", "schema": "coverage.rlvr-evaluation.v1", "immutability": "immutable", "fingerprint": "sha256"}
    },
    "components": {
      "core": {
        "adapter": "trainvm.core",
        "version": "1.0.0",
        "runtime": "builtin",
        "operations": {
          "acquire_resources": {"contract": "trainvm.v1.AcquireResources"},
          "release_resources": {"contract": "trainvm.v1.ReleaseResources"}
        }
      },
      "rwkv_rlvr": {
        "adapter": "coverage.rwkv-rlvr",
        "version": "1.0.0-coverage",
        "runtime": "python_worker",
        "operations": {
          "seal_inputs": {"contract": "coverage.rwkv_rlvr.v1.SealTrainingInputs"},
          "train_policy": {"contract": "coverage.rwkv_rlvr.v1.TrainCompatiblePolicy"},
          "evaluate_policy": {"contract": "coverage.rwkv_rlvr.v1.EvaluatePolicy"}
        }
      }
    },
    "workflow": {
      "entrypoint": "acquire_resources",
      "nodes": {
        "acquire_resources": {
          "invoke": {"component": "core", "operation": "acquire_resources", "inputs": {
            "concurrency_key": {"literal": "coverage-rwkv-rlvr"}
          }},
          "idempotency": "receipt_required",
          "effect": "resource",
          "transitions": [
            {"on": "resource.acquired", "target": "seal_inputs"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "seal_inputs": {
          "invoke": {"component": "rwkv_rlvr", "operation": "seal_inputs", "inputs": {
            "parent": {"parameter": "parent_checkpoint_path"},
            "tasks": {"parameter": "heldout_tasks_path"},
            "verifier": {"parameter": "verifier_identity"},
            "run_directory": {"context": "run_directory"}
          }},
          "publishes": {"inputs": "rlvr_inputs"},
          "idempotency": "replay_safe",
          "effect": "read_only",
          "timeout_seconds": 600,
          "transitions": [
            {"on": "operation.completed", "target": "train_policy"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "train_policy": {
          "invoke": {"component": "rwkv_rlvr", "operation": "train_policy", "inputs": {
            "inputs": {"artifact": "rlvr_inputs"},
            "rollout_tokens": {"parameter": "rollout_token_budget"},
            "run_directory": {"context": "run_directory"}
          }},
          "publishes": {"checkpoint": "policy_checkpoint", "metrics": "rollout_metrics"},
          "idempotency": "receipt_required",
          "effect": "process",
          "timeout_seconds": 86400,
          "transitions": [
            {"on": "worker.completed", "target": "evaluate_policy"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "evaluate_policy": {
          "invoke": {"component": "rwkv_rlvr", "operation": "evaluate_policy", "inputs": {
            "checkpoint": {"artifact": "policy_checkpoint"},
            "inputs": {"artifact": "rlvr_inputs"}
          }},
          "publishes": {"report": "evaluation_report"},
          "idempotency": "replay_safe",
          "effect": "process",
          "timeout_seconds": 7200,
          "transitions": [
            {"on": "operation.completed", "target": "release_resources"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        },
        "release_resources": {
          "invoke": {"component": "core", "operation": "release_resources", "inputs": {
            "concurrency_key": {"literal": "coverage-rwkv-rlvr"}
          }},
          "idempotency": "replay_safe",
          "effect": "resource",
          "transitions": [
            {"on": "resource.released", "target": "$completed"},
            {"on": "operation.failed", "target": "$failed"}
          ]
        }
      }
    },
    "controls": {"catalog": {
      "rollout_temperature": {
        "type": "number", "default": 0.8, "minimum": 0.1, "maximum": 2,
        "apply": "next_eval", "mutable_after_start": true,
        "targets": ["rwkv_rlvr.train_policy.rollout_temperature"], "unit": "ratio"
      }
    }},
    "observability": {
      "heartbeat_seconds": 5,
      "metrics": [
        {"name": "train.reward", "type": "gauge", "unit": "dimensionless", "step_domain": "sample", "aggregation": "mean"},
        {"name": "eval.pass_at_1", "type": "gauge", "unit": "ratio", "step_domain": "optimizer_step", "aggregation": "max"}
      ],
      "retain_raw_metrics_days": 30
    },
    "recovery": {
      "exact_resume": false,
      "checkpoint_artifact": "policy_checkpoint",
      "reconcile": "restart_from_checkpoint",
      "orphan_policy": "leave_and_block",
      "graceful_stop_seconds": 300
    }
  }
}
