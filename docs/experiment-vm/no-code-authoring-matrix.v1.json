{
  "api_version": "trainvm.no-code-authoring-matrix/v1",
  "authority": "qualification_declaration_only",
  "comment": "This matrix declares the minimum no-code authoring release qualification. It cannot launch work or report an outcome. A sealed TrainVM qualification run produces the measured receipt after the registered recipes exist.",
