{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rwkv-lab.local/schemas/trainvm/experiment-v1.schema.json",
  "title": "TrainVM declarative experiment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "api_version": {
      "const": "trainvm.rwkv-lab/v1alpha1"
    },
    "kind": {
      "const": "Experiment"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 128
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "description": {
          "type": "string",
          "maxLength": 4096
        },
        "labels": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 256
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace",
        "resources",
        "parameters",
        "artifacts",
        "components",
        "workflow",
        "controls",
        "observability",
        "recovery"
      ],
      "properties": {
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "execution": {
          "$ref": "#/$defs/execution_phases"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/parameter"
          }
        },
        "artifacts": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/component"
          }
        },
        "workflow": {
          "$ref": "#/$defs/workflow"
        },
        "controls": {
          "$ref": "#/$defs/controls"
        },
        "observability": {
          "$ref": "#/$defs/observability"
        },
        "recovery": {
          "$ref": "#/$defs/recovery"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "run_directory",
        "concurrency_key"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "run_directory": {
          "type": "string",
          "minLength": 1
        },
        "concurrency_key": {
          "$ref": "#/$defs/identifier"
        },
        "allowed_read_roots": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "input_content_roots": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/input_content_root"
          }
        },
        "allowed_write_roots": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      }
    },
    "input_content_root": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "api_version",
        "path",
        "kind",
        "file_count",
        "total_bytes",
        "tree_sha256"
      ],
      "properties": {
        "api_version": {
          "const": "trainvm.input-content-root/v1"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "kind": {
          "enum": [
            "file",
            "directory"
          ]
        },
        "file_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18014398509481984
        },
        "tree_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accelerators"
      ],
      "properties": {
        "accelerators": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vendor",
            "count",
            "exclusive"
          ],
          "properties": {
            "vendor": {
              "enum": [
                "nvidia",
                "amd",
                "intel",
                "none"
              ]
            },
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 256
            },
            "minimum_memory_gib": {
              "type": "number",
              "minimum": 0
            },
            "exclusive": {
              "type": "boolean"
            },
            "selector": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "minimum_host_memory_gib": {
          "type": "number",
          "minimum": 0
        },
        "cpu_threads": {
          "type": "integer",
          "minimum": 1
        },
        "lease_timeout_seconds": {
          "type": "integer",
          "minimum": 5,
          "default": 30
        },
        "cpu_io_policy": {
          "$ref": "#/$defs/cpu_io_policy"
        }
      }
    },
    "cpu_io_policy": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "cpuset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[0-9]+(?:-[0-9]+)?(?:,[0-9]+(?:-[0-9]+)?)*$"
        },
        "cpus": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1048575
          }
        },
        "cpu_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "io_weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "omp_threads": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "preprocessing_workers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "nice": {
          "type": "integer",
          "minimum": -20,
          "maximum": 19
        }
      },
      "not": {
        "required": [
          "cpuset",
          "cpus"
        ]
      }
    },
    "execution_phases": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "operation"
      ],
      "properties": {
        "component": {
          "$ref": "#/$defs/identifier"
        },
        "operation": {
          "$ref": "#/$defs/identifier"
        },
        "compile": {
          "$ref": "#/$defs/compile_phase"
        },
        "warmup": {
          "$ref": "#/$defs/step_phase"
        },
        "qualify": {
          "$ref": "#/$defs/step_phase"
        },
        "gpu_trace": {
          "$ref": "#/$defs/gpu_trace_capture"
        }
      },
      "anyOf": [
        {
          "required": [
            "compile"
          ]
        },
        {
          "required": [
            "warmup"
          ]
        },
        {
          "required": [
            "qualify"
          ]
        },
        {
          "required": [
            "gpu_trace"
          ]
        }
      ]
    },
    "compile_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "step_phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "steps"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "steps"
              ]
            }
          }
        }
      ]
    },
    "gpu_trace_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "backend": {
          "enum": [
            "torch",
            "nsys",
            "ncu"
          ]
        },
        "warmup_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "skip_steps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "capture_steps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "output_artifact": {
          "$ref": "#/$defs/identifier"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "contains": {
            "const": "accelerator"
          },
          "items": {
            "enum": [
              "cpu",
              "accelerator"
            ]
          }
        },
        "record_shapes": {
          "type": "boolean"
        },
        "profile_memory": {
          "type": "boolean"
        },
        "with_stack": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "backend",
              "warmup_steps",
              "skip_steps",
              "capture_steps",
              "output_artifact",
              "activities"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "backend"
                  ]
                },
                {
                  "required": [
                    "warmup_steps"
                  ]
                },
                {
                  "required": [
                    "skip_steps"
                  ]
                },
                {
                  "required": [
                    "capture_steps"
                  ]
                },
                {
                  "required": [
                    "output_artifact"
                  ]
                },
                {
                  "required": [
                    "activities"
                  ]
                },
                {
                  "required": [
                    "record_shapes"
                  ]
                },
                {
                  "required": [
                    "profile_memory"
                  ]
                },
                {
                  "required": [
                    "with_stack"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "enum": [
                  "nsys",
                  "ncu"
                ]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "record_shapes"
                  ]
                },
                {
                  "required": [
                    "profile_memory"
                  ]
                },
                {
                  "required": [
                    "with_stack"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "backend"
            ],
            "properties": {
              "backend": {
                "const": "ncu"
              }
            }
          },
          "then": {
            "properties": {
              "activities": {
                "const": [
                  "accelerator"
                ]
              }
            }
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "enum": [
            "string",
            "integer",
            "number",
            "boolean",
            "path",
            "duration"
          ]
        },
        "value": true,
        "description": {
          "type": "string"
        },
        "secret_reference": {
          "type": "boolean",
          "default": false
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "secret_reference"
            ],
            "properties": {
              "secret_reference": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              },
              "value": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^secret://[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}/[a-zA-Z0-9][a-zA-Z0-9._/-]{0,255}#[a-zA-Z0-9][a-zA-Z0-9._-]{0,63}$"
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "immutability",
        "fingerprint"
      ],
      "properties": {
        "type": {
          "enum": [
            "path",
            "checkpoint",
            "dataset",
            "image_gallery",
            "metrics",
            "report",
            "opaque"
          ]
        },
        "schema": {
          "type": "string"
        },
        "immutability": {
          "enum": [
            "immutable",
            "append_only",
            "mutable_until_publish"
          ]
        },
        "fingerprint": {
          "enum": [
            "sha256",
            "manifest_sha256",
            "adapter",
            "none"
          ]
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "description": {
          "type": "string"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter",
        "version",
        "runtime",
        "operations"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "enum": [
            "builtin",
            "python_worker",
            "native_worker",
            "external_worker"
          ]
        },
        "operations": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "contract"
            ],
            "properties": {
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal"
          ],
          "properties": {
            "literal": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parameter"
          ],
          "properties": {
            "parameter": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact"
          ],
          "properties": {
            "artifact": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "control"
          ],
          "properties": {
            "control": {
              "$ref": "#/$defs/identifier"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "context"
          ],
          "properties": {
            "context": {
              "enum": [
                "run_id",
                "run_directory",
                "plan_revision",
                "attempt_id",
                "host_id"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "node_output"
          ],
          "properties": {
            "node_output": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node",
                "name"
              ],
              "properties": {
                "node": {
                  "$ref": "#/$defs/identifier"
                },
                "name": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "operator",
        "value"
      ],
      "properties": {
        "field": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge",
            "in",
            "not_in",
            "exists"
          ]
        },
        "value": true
      }
    },
    "predicate": {
      "oneOf": [
        {
          "$ref": "#/$defs/comparison"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/predicate"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/predicate"
            }
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on",
        "target"
      ],
      "properties": {
        "on": {
          "type": "string",
          "minLength": 1
        },
        "where": {
          "$ref": "#/$defs/predicate"
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maximum_attempts",
        "backoff"
      ],
      "properties": {
        "maximum_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "backoff": {
          "enum": [
            "none",
            "fixed",
            "exponential"
          ]
        },
        "initial_delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "maximum_delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "retryable_events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "loop_guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_visits",
        "progress_field",
        "direction"
      ],
      "properties": {
        "max_visits": {
          "type": "integer",
          "minimum": 2,
          "maximum": 1000000
        },
        "progress_field": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$"
        },
        "direction": {
          "enum": [
            "increasing",
            "decreasing"
          ]
        }
      }
    },
    "training_component_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "name",
        "version"
      ],
      "properties": {
        "category": {
          "enum": [
            "optimizer",
            "parameter_router",
            "learning_rate_schedule",
            "weight_decay_schedule",
            "activation",
            "normalization",
            "objective",
            "precision",
            "gradient_clipping",
            "gradient_accumulation",
            "curriculum",
            "metric_reducer"
          ]
        },
        "name": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "training_component_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "configuration"
      ],
      "properties": {
        "key": {
          "$ref": "#/$defs/training_component_key"
        },
        "configuration": {
          "type": "object",
          "maxProperties": 128,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": [
              "boolean",
              "integer",
              "number",
              "string"
            ]
          }
        }
      }
    },
    "training_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_family",
        "components"
      ],
      "properties": {
        "model_family": {
          "$ref": "#/$defs/identifier"
        },
        "components": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/training_component_selection"
          }
        },
        "topologies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/training_topology_selection"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoke",
        "idempotency",
        "effect",
        "transitions"
      ],
      "properties": {
        "description": {
          "type": "string"
