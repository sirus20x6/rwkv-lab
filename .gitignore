# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-mage-flow/
.venv-mage-flow-fa4/
.venv-*/
.external/
.ipynb_checkpoints/
.env
.env.*
!.env.example

# --- Caches / local tool metadata ---
caches/
cache/
downloads/
.uv_cache/
.hf_cache/
.codex
.codex/
.claude/
.triton/

# --- Large/generated model + experiment artifacts (weights, states, checkpoints) ---
# dir-level so git never recurses into the >1TB of data
Qwen*/
converted*/
engram*/
mem_targets/
runs/
research/
artifacts/
checkpoints/
weights/
# weight/state blobs anywhere (lenses, plans, patches, ckpts)
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf
*.onnx

# --- Dashboards: SQLite DBs + compiled binaries (the Go/JS *source* is tracked) ---
*.db
*.db-wal
*.db-shm
# compiled Go binaries (built from ./cmd/trainboard); source stays tracked
dashboard/trainboard
dashboard/trainboard-candidate*
dashboard/trainboard.before-*
dashboard/launches/

# --- Logs and local process metadata ---
*.log
.supervisor_child_*

# --- Retired v1 code (kept locally, not part of the public repo) ---
legacy/

# --- Editor / OS cruft ---
*.swp
*.tmp
.DS_Store
experiments.db
models/cache/

# --- Private/local data ---
# Keep every corpus and generated dataset product below one of these generic
# roots. Source code receives paths through configuration or environment
# variables; local provenance and machine paths never belong in Git.
/data/
/dataset/
/datasets/
/corpora/
/private/
/local/
/models/
/review-packs/
/generated-manifests/
*.partial.jsonl
*.manifest.local.txt
*.receipt.local.json

# Local dashboard process state.
/dashboard/trainboard.pid
