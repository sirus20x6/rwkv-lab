# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.venv-mage-flow/
.venv-mage-flow-fa4/
.external/
.ipynb_checkpoints/

# --- Caches / local tool metadata ---
caches/
.uv_cache/
.hf_cache/
.codex
.codex/
.claude/
.triton/

# --- Large/generated model + experiment artifacts (weights, states, checkpoints) ---
# dir-level so git never recurses into the >1TB of data
Qwen*/
converted*/
engram*/
mem_targets/
runs/
research/
# weight/state blobs anywhere (lenses, plans, patches, ckpts)
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.gguf
*.onnx

# --- Dashboards: SQLite DBs + compiled binaries (the Go/JS *source* is tracked) ---
*.db
*.db-wal
*.db-shm
# compiled Go binaries (built from ./cmd/trainboard); source stays tracked
dashboard/trainboard
dashboard/trainboard-candidate*
dashboard/trainboard.before-*
trainvm/build/
trainvm/build-*/
dashboard/launches/

# --- Logs and local process metadata ---
*.log
.supervisor_child_*

# --- Retired v1 code (kept locally, not part of the public repo) ---
legacy/

# --- Editor / OS cruft ---
*.swp
*.tmp
.DS_Store
experiments.db
models/cache/

# --- Local multimodal corpora, generated manifests, and model trees ---
# These directories contain multi-GB/TB downloads, extracted images, local
# absolute paths, generated review packs, and third-party dataset metadata.
/datasets/
/models/
/curated_vision/
/NSFW_Manga/
/i1-captions/
/joy-captioning-*/
/nsfw-video-still-caption-grid-only/
/nsfw_scene_animes_*/
/quality_review_pack/
/quality_review_updated/

# Local dashboard process state.
/dashboard/trainboard.pid

# Acceptance and qualification output. `scripts/acceptance.sh` and the CI
# workflows write receipts, JUnit XML, logs, and whole qualification trees here.
# It is generated output, not source: CI uploads it as a build artifact, and a
# receipt committed to git would claim the commit it is checked out at rather
# than the one it actually ran against.
#
# The `*.pt`/`*.safetensors`/`*.bin` rules above already caught the heavy
# payloads — of the 187 files one GPU qualification run left here, 150 (~4.3MB)
# were still stageable: receipts, configs, manifests, logs. So the exposure was
# never mostly about size. It was that `git add -A` would quietly commit 150
# files of stale run output, and that is worth ruling out by shape rather than
# relying on extension rules to keep coincidentally covering it.
/evidence/
