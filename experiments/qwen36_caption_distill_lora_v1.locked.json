                    "version": "1.0.0"
                  },
                  "configuration": {
                    "warmup_steps": 22,
                    "max_steps": 745,
                    "minimum_ratio": 0.09999999999999999
                  }
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "torch_adamw_no_decay",
                    "version": "2.0.0"
                  },
                  "configuration": {
                    "learning_rate": 0.00002,
                    "beta1": 0.9,
                    "beta2": 0.95,
                    "epsilon": 1e-08,
                    "foreach": false,
                    "fused": true
