                  "attention_implementation": "flash_attention_2",
                  "experts_implementation": "grouped_mm",
                  "minimum_free_vram_gib": 90.0,
                  "resume": "",
                  "auto_resume": true
                }
              }
            },
            "training": {
              "model_family": "transformer",
              "components": {
                "gradient_accumulation": {
                  "key": {
                    "category": "gradient_accumulation",
                    "name": "fixed",
                    "version": "1.0.0"
                  },
                  "configuration": {"microbatches_per_optimizer_step": 16}
                },
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {
