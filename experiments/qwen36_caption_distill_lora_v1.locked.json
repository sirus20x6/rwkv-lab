          "invoke": {
            "component": "caption_finetune",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "model_dir": "/thearray/git/ob/text-generation-webui/models/Qwen3.6-35B-A3B-heretic",
