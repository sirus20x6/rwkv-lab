                  "max_pixels": 1048576,
                  "min_pixels": 65536,
                  "max_text_tokens": 1024,
                  "max_new_tokens": 768,
                  "eval_every": 250,
                  "save_every": 250,
                  "log_every": 1,
                  "validation_generation_count": 100,
                  "seed": 20260805,
