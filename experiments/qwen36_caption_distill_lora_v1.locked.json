                  "epochs": 1,
                  "micro_batch_size": 1,
                  "gradient_accumulation_steps": 16,
                  "lora_rank": 256,
                  "lora_alpha": 512,
                  "lora_dropout": 0.05,
                  "learning_rate": 0.00002,
                  "min_learning_rate": 0.000002,
                  "warmup_ratio": 0.03,
                  "weight_decay": 0.01,
                  "adam_beta1": 0.9,
                  "adam_beta2": 0.95,
                  "adam_epsilon": 1e-08,
