{
  "api_version": "trainvm.rwkv-lab/v1alpha1",
  "kind": "Experiment",
  "metadata": {
    "name": "mageflow-terminal-continuation-step3952",
    "description": "Continue the routed photo/animation terminal experts and final backbone third from the frozen legacy step-3952 state, with startup evaluation and checkpoint-first resource-releasing pause support.",
    "labels": {
      "family": "mageflow",
      "architecture": "terminal-experts-tread-repa",
      "source_step": "3952"
    }
  },
  "spec": {
    "workspace": {
      "root": "/thearray/git/moe-mla-parity-integration",
      "run_directory": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-step3952",
      "concurrency_key": "local-gpu-training",
      "allowed_read_roots": [
        "/mnt/hypercard/mageflow-cache/trainvm-terminal-continuation-step3952/entries",
        "/thearray/git/datasets/anima-civitai-balanced-10000/images/sfw",
        "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024",
        "/thearray/git/datasets/midjourney-v6-recap-stage-100k/images/eval",
        "/thearray/git/datasets/porn/reddit/trainer-eval-128",
        "/thearray/git/moe-mla/experiments/mageflow_terminal_alternating_epoch_schedule.json",
        "/thearray/git/moe-mla-parity-integration",
        "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-inputs-step3952/checkpoint-00003952",
        "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base"
      ],
      "allowed_write_roots": [
        "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-step3952"
      ]
    },
    "resources": {
      "accelerators": {
        "vendor": "nvidia",
        "count": 1,
        "minimum_memory_gib": 80,
        "exclusive": false
      },
      "minimum_host_memory_gib": 64,
      "cpu_threads": 16,
      "lease_timeout_seconds": 300,
      "cpu_io_policy": {
        "cpu_weight": 100,
        "io_weight": 100,
        "omp_threads": 4,
        "preprocessing_workers": 4,
        "nice": 0
      }
    },
    "parameters": {},
    "artifacts": {
      "checkpoint": {
        "type": "checkpoint",
        "schema": "rwkv-lab.mageflow-checkpoint.v1",
        "immutability": "immutable",
        "fingerprint": "manifest_sha256",
        "required": true
      },
      "eval_gallery": {
        "type": "image_gallery",
        "schema": "rwkv-lab.eval-gallery.v2",
        "immutability": "append_only",
        "fingerprint": "manifest_sha256",
        "required": true
      }
    },
    "components": {
      "core": {
        "adapter": "trainvm.core",
        "version": "1.0.0",
        "runtime": "builtin",
        "operations": {
          "acquire_resources": {
            "contract": "trainvm.v1.AcquireResources"
          },
          "release_resources": {
            "contract": "trainvm.v1.ReleaseResources"
          }
        }
      },
      "trainer": {
        "adapter": "rwkv-lab.mageflow-terminal-expert",
        "version": "1.0.0",
        "runtime": "python_worker",
        "operations": {
          "train": {
            "contract": "rwkv_lab.mageflow_terminal_expert.v1.Train"
          }
        }
      }
    },
    "execution": {
      "component": "trainer",
      "operation": "train",
      "compile": {
        "enabled": false
      }
    },
    "workflow": {
      "entrypoint": "acquire_gpu",
      "nodes": {
        "acquire_gpu": {
          "effect": "resource",
          "idempotency": "receipt_required",
          "invoke": {
            "component": "core",
            "operation": "acquire_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "local-gpu-training"
              }
            }
          },
          "transitions": [
            {
              "on": "resource.acquired",
              "target": "train"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "train": {
          "effect": "process",
          "idempotency": "receipt_required",
          "invoke": {
            "component": "trainer",
            "operation": "train",
            "inputs": {
              "config": {
                "literal": {
                  "activation_checkpointing_mode": "full",
                  "adam_beta1": 0.9,
                  "adam_beta2": 0.95,
                  "adam_epsilon": 1e-08,
                  "allow_objective_migration_on_resume": true,
                  "attention_backend": "flash2",
                  "backbone_learning_rate_multiplier": 0.5,
                  "balance_accumulation_window": true,
                  "caption_dropout": 0.1,
                  "checkpoint_every": 500,
                  "compile_transformer_blocks": false,
                  "compile_transformer_dynamic": false,
                  "compile_transformer_mode": "default",
                  "compile_vae_encoder": true,
                  "domain": "animation",
                  "domain_window_schedule": "/thearray/git/moe-mla/experiments/mageflow_terminal_alternating_epoch_schedule.json",
                  "encoder_cache_coverage_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/train.jsonl",
                  "encoder_cache_covered_until_step": 12228,
                  "encoder_cache_dir": "/mnt/hypercard/mageflow-cache/trainvm-terminal-continuation-step3952/entries",
                  "encoder_cache_mode": "read_only",
                  "eval_every": 500,
                  "eval_examples": null,
                  "eval_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/eval.jsonl",
                  "eval_microbatch_size": 1,
                  "eval_on_resume": true,
                  "expert_checkpoint": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-inputs-step3952/checkpoint-00003952/mageflow-animation-terminal-expert.safetensors",
                  "expert_checkpoints": {
                    "animation": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-inputs-step3952/checkpoint-00003952/mageflow-animation-terminal-expert.safetensors",
                    "photo": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-inputs-step3952/checkpoint-00003952/mageflow-photo-terminal-expert.safetensors"
                  },
                  "expert_optimizer_state_device": "cuda",
                  "float8_recipe": "tensorwise",
                  "float8_training": false,
                  "flow_loss_weighting": "soft_min_snr",
                  "flow_min_snr_gamma": 5.0,
                  "gradient_accumulation_steps": 2,
                  "gradient_checkpointing": true,
                  "immiscible_enabled": true,
                  "keep_last_n": 3,
                  "learning_rate": 1e-06,
                  "lightning_rmsnorm": false,
                  "lightning_swiglu": false,
                  "loop_gate_max_grad_norm": 1.0,
                  "loop_gate_update_multiplier": 25.0,
                  "max_grad_norm": 1.0,
                  "max_steps": 12228,
                  "microbatch_size": 4,
                  "min_learning_rate_ratio": 0.1,
                  "mixed_precision": "bf16",
                  "model_id": "microsoft/Mage-Flow-Base",
                  "model_path": "/thearray/git/ob/text-generation-webui/models/Mage-Flow-Base",
                  "model_revision": "59a9cfd58cf6ecef28245852c6bdace3f12428a2",
                  "normalize_flow_loss_weights": true,
                  "official_source_revision": "ef932e2cc3e94bb026d937a6cffae65492adc0fb",
                  "offload_cached_encoders": true,
                  "offload_replaced_backbone_core": false,
                  "output_dir": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-step3952",
                  "prefetch_batches": 4,
                  "rapid_expert_alternation": true,
                  "repa_enabled": true,
                  "repa_exclude_loop_gate_gradients": true,
                  "repa_hidden_layer": 1,
                  "repa_learning_rate_multiplier": 1.0,
                  "repa_loss_weight": 0.1,
                  "repa_per_example_loss_cap": 5.0,
                  "repa_projection_hidden_dim": null,
                  "repa_reset_projection_on_resume": false,
                  "repa_smooth_l1_beta": 1.0,
                  "repa_student_normalization": "token_rms",
                  "repa_use_posterior_mean": true,
                  "reset_optimizer_on_architecture_migration": false,
                  "resume_from": "/thearray/git/moe-mla/runs/trainvm-mageflow-terminal-continuation-inputs-step3952/checkpoint-00003952",
                  "seed": 42,
                  "shared_backbone_checkpoint": null,
                  "timestep_sampling": "logit_normal",
                  "timestep_shift": 1.0,
                  "train_backbone_final_fraction": 0.3333333333333333,
                  "train_manifest": "/thearray/git/datasets/midjourney-v6-recap-continuation-30pct-b-512-1024/train.jsonl",
                  "tread_factored_looping": {
                    "combined": {
                      "enabled": true,
                      "tread_mask_policy": "fixed_per_forward"
                    },
                    "looping": {
                      "auxiliary_schedule": "increasing",
                      "auxiliary_weight": 0.1,
                      "enabled": true,
                      "factorization": {
                        "adaptive_halt": true,
                        "enabled": true,
                        "gate_cap": 0.25,
                        "gate_mode": "factored",
                        "inference_gate_threshold": 0.0001,
                        "ponder_prior": 0.1,
                        "ponder_weight": 0.01
                      },
                      "loop_count": 3,
                      "loop_embedding": true,
                      "use_auxiliary_loss": true
                    },
                    "tread": {
                      "active_timestep_max": null,
                      "active_timestep_min": null,
                      "enabled": true,
                      "image_tokens_only": true,
                      "inference_enabled": false,
                      "min_active_image_tokens": 1,
                      "route_end": -4,
                      "route_fraction": 0.5,
                      "route_start": 2,
                      "same_mask_across_loop_iterations": true,
                      "selection": "random"
                    }
                  },
                  "tread_loop_checkpoint": null,
                  "vae_sample_posterior": true,
                  "velocity_direction_loss_epsilon": 1e-06,
                  "velocity_direction_loss_weight": 0.1,
                  "warmup_steps": 250,
                  "weight_decay": 0.01
                }
              }
            },
            "training": {
              "model_family": "mageflow",
              "components": {
                "gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "error_if_nonfinite": false,
                    "max_norm": 1.0,
                    "norm_type": 2.0
                  }
                },
                "learning_rate": {
                  "key": {
                    "category": "learning_rate_schedule",
                    "name": "linear_warmup_cosine",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "max_steps": 12228,
                    "minimum_ratio": 0.1,
                    "warmup_steps": 250
                  }
                },
                "loop_gate_gradient_clipping": {
                  "key": {
                    "category": "gradient_clipping",
                    "name": "global_norm",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "error_if_nonfinite": false,
                    "max_norm": 1.0,
                    "norm_type": 2.0
                  }
                },
                "optimizer": {
                  "key": {
                    "category": "optimizer",
                    "name": "torch_adamw_no_decay",
                    "version": "2.0.0"
                  },
                  "configuration": {
                    "beta1": 0.9,
                    "beta2": 0.95,
                    "epsilon": 1e-08,
                    "foreach": true,
                    "fused": false,
                    "learning_rate": 1e-06
                  }
                },
                "parameter_router": {
                  "key": {
                    "category": "parameter_router",
                    "name": "mageflow_terminal_expert",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "repa_projection_multiplier": 1.0,
                    "shared_backbone_multiplier": 0.5
                  }
                },
                "weight_decay": {
                  "key": {
                    "category": "weight_decay_schedule",
                    "name": "constant",
                    "version": "1.0.0"
                  },
                  "configuration": {
                    "weight_decay": 0.01
                  }
                }
              }
            }
          },
          "publishes": {
            "checkpoint": "checkpoint",
            "eval_gallery": "eval_gallery"
          },
          "timeout_seconds": 604800,
          "transitions": [
            {
              "on": "worker.completed",
              "target": "release_gpu"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        },
        "release_gpu": {
          "effect": "resource",
          "idempotency": "replay_safe",
          "invoke": {
            "component": "core",
            "operation": "release_resources",
            "inputs": {
              "concurrency_key": {
                "literal": "local-gpu-training"
              }
            }
          },
          "transitions": [
            {
              "on": "resource.released",
              "target": "$completed"
            },
            {
              "on": "operation.failed",
              "target": "$failed"
            }
          ]
        }
      }
    },
    "controls": {
      "catalog": {}
    },
    "observability": {
      "heartbeat_seconds": 5,
      "metrics": [
        {
          "name": "train.loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "weighted_mean"
        },
        {
          "name": "train.images_per_second",
          "type": "gauge",
          "unit": "image/second",
          "step_domain": "optimizer_step",
          "aggregation": "mean"
        },
        {
          "name": "eval/primary_loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "eval/optimization_loss",
          "type": "gauge",
          "unit": "dimensionless",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        },
        {
          "name": "eval/gallery_samples",
          "type": "gauge",
          "unit": "image",
          "step_domain": "optimizer_step",
          "aggregation": "last"
        }
      ],
      "retain_raw_metrics_days": 30,
      "eval_gallery_artifact": "eval_gallery"
    },
    "recovery": {
      "exact_resume": false,
      "checkpoint_artifact": "checkpoint",
      "reconcile": "restart_from_checkpoint",
      "orphan_policy": "leave_and_block",
      "graceful_stop_seconds": 300,
      "release_accelerators_when_paused": true
    }
  }
}
